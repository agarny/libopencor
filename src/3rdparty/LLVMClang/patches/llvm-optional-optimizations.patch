+/* libOpenCOR: define to 1 to support the optimizations that the default
+   pipelines only perform with profile data, a vector library or a command-line
+   option, and to 0 otherwise (see LLVM_ENABLE_OPTIONAL_OPTIMIZATIONS in
+   llvm/CMakeLists.txt). */
+#cmakedefine01 LLVM_ENABLE_OPTIONAL_OPTIMIZATIONS
